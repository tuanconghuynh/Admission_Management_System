ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://ams:URL_ENCODED_PASSWORD@db:3306/Admission_Management_System?charset=utf8mb4
SESSION_SECRET=
AUDIT_HMAC_SECRET=
DELETE_KEY_SECRET=
COOKIE_SECURE=true
AUTO_CREATE_TABLES=false
ALLOWED_HOSTS=ams.example.com
ALLOWED_ORIGINS=https://ams.example.com
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
MAX_REQUEST_BYTES=10485760
MAX_REPORT_ROWS=1000
MAX_EMAIL_BATCH=100
LOGIN_RATE_LIMIT=10
EMAIL_RATE_LIMIT=20
EMAIL_MAX_ATTEMPTS=3
RECEIPTS_DIR=var/receipts
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_STARTTLS=false
SMTP_SSL_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Viện Đại học Mở HUTECH
REPLY_TO_EMAIL=no-reply@example.com
